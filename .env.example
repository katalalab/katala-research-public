# Katala Research — environment variables
# Copy to .env (in this dir) and fill in. .env is git-ignored.
# All values below are OPTIONAL — Katala Research falls back to stub backends
# when keys are missing, but you'll get rate-limited / lower-quality results.

# === ★★★ Strongly recommended (free, no signup beyond email) ===

# OpenAlex polite pool. Free, no API key — just provide an email to get 10 req/s
# and priority queue. https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication#the-polite-pool
OPENALEX_MAILTO=

# Anthropic Claude API. https://console.anthropic.com/
# Also resolvable from ~/.anthropic/api_key — env var takes precedence.
ANTHROPIC_API_KEY=

# === ★★ Recommended (free signup) ===

# Semantic Scholar API key. Free, raises rate limit from 1 req/s to ~100 req/s.
# https://www.semanticscholar.org/product/api/
SEMANTIC_SCHOLAR_API_KEY=

# Ai2 Asta MCP (Semantic Scholar superset, 200M+ paper index over MCP).
# Request key: https://share.hsforms.com/1L4hUh20oT3mu8iXJQMV77w3ioxm
ASTA_API_KEY=

# === ★ Optional ===

# Crossref polite pool (only used when resolving DOIs).
# https://www.crossref.org/documentation/retrieve-metadata/rest-api/tips-for-using-the-rest-api/
CROSSREF_MAILTO=

# OpenReview API auth — ONLY needed for non-public venues.
# Public ICLR/NeurIPS/COLM submissions and reviews work anonymously.
# https://docs.openreview.net/getting-started/using-the-api/installing-and-instantiating-the-python-client
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# === Search backends (optional, fall back to stub) ===

# SearXNG endpoint (start via vendor/searxng-docker/docker compose up).
SEARXNG_URL=http://localhost:8080

# Optional commercial search backends. None are required.
# EXA_API_KEY=
# TAVILY_API_KEY=
# LINKUP_API_KEY=
# FIRECRAWL_API_KEY=
# BRAVE_SEARCH_API_KEY=

# === Read backends ===

# Jina Reader API key (optional — without it, you get a free 10M tokens/key tier
# via anonymous r.jina.ai access).
# JINA_API_KEY=
